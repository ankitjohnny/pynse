# Project Anti-Gravity — environment variables
# Copy to .env and fill in your values (never commit .env to git)

# ── Required ──────────────────────────────────────────────────────────────────
# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIzaSy...

# ── Optional: Google Drive sync ───────────────────────────────────────────────
# Path to OAuth 2.0 Desktop credentials JSON downloaded from Google Cloud Console
# Leave empty to use local-only state ledger
GDRIVE_CREDENTIALS_PATH=~/.anti_gravity/gdrive_credentials.json
